# ── TMUG Website — environment variables ──────────────────────────────
# Copy this file to `.env.local` for local development.
# NEVER commit real secrets to git. On Vercel set these in
# Project → Settings → Environment Variables, then redeploy.

# Canonical public URL of the site (used for canonical tags, sitemap, OG).
# Example: https://tmug.in
NEXT_PUBLIC_SITE_URL=https://tmug.in

# ── Admin panel (/admin) ───────────────────────────────────────────────
ADMIN_EMAIL=admin@tmug
ADMIN_PASSWORD=change-me-in-production
# Signs the admin session cookie. Use a long random value:  openssl rand -base64 32
# (If omitted, a key is derived from ADMIN_PASSWORD — setting this is recommended.)
ADMIN_SESSION_SECRET=

# ── Database (REQUIRED for products, orders, payments, reports) ────────
# Any PostgreSQL ≥ 13 (Neon, Vercel Postgres, Supabase…). POSTGRES_URL is accepted as an alias.
# Tables are created automatically on first use; your existing catalogue is imported once.
# Optional manual run:  npm run db:migrate
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Payment gateway: Razorpay (REQUIRED for online checkout) ───────────
# Without KEY_ID + KEY_SECRET online payment stays OFF and the cart keeps offering "Order on WhatsApp".
# Start with TEST keys (rzp_test_…); switch to live keys (rzp_live_…) when you are ready.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you choose when creating the webhook in the Razorpay dashboard
# (URL: https://<your-domain>/api/payments/razorpay/webhook). Confirms payments even if a customer closes the page.
RAZORPAY_WEBHOOK_SECRET=

# ── Image storage for product uploads (Vercel Blob) ────────────────────
# Create a Blob store in Vercel → Storage; the token is added automatically.
BLOB_READ_WRITE_TOKEN=
