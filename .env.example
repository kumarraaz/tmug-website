# ── TMUG Website — environment variables ──────────────────────────────
# Copy this file to `.env.local` for local development.
# NEVER commit real secrets to git.

# Canonical public URL of the site (used for canonical tags, sitemap, OG).
# Example: https://tmug.in
NEXT_PUBLIC_SITE_URL=https://tmug.in

# Password protecting /admin/seo. Use a long random string in production.
# Generate one with: openssl rand -base64 32
ADMIN_PASSWORD=admin@tmug
